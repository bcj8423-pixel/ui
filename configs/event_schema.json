{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ICNS Experiment Event Log",
  "type": "object",
  "required": [
    "event_id",
    "timestamp_utc",
    "participant_id",
    "study_id",
    "condition_id",
    "stage",
    "event_type"
  ],
  "properties": {
    "event_id": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "participant_id": {"type": "string", "pattern": "^S[1-4]-P[0-9]{4}$"},
    "study_id": {"type": "string", "enum": ["study1", "study2", "study3", "study4"]},
    "condition_id": {"type": "string"},
    "session": {"type": "integer", "minimum": 1, "maximum": 2},
    "stage": {
      "type": "string",
      "enum": ["baseline", "manipulation", "prediction_transfer", "platform", "pretask", "t1", "t2"]
    },
    "item_id": {"type": "string"},
    "event_type": {
      "type": "string",
      "enum": [
        "item_shown",
        "answer_submitted",
        "ai_opened",
        "ai_prompt_sent",
        "ai_response_received",
        "prediction_submitted",
        "scale_submitted"
      ]
    },
    "response": {"type": ["string", "number", "null"]},
    "is_correct": {"type": ["boolean", "null"]},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "ai_turn_index": {"type": ["integer", "null"], "minimum": 1},
    "meta": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
